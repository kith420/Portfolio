# Password gate for /resume. Copy to .env.local for local development, and set
# both in the host's environment variables (e.g. Vercel) for production.

# What a visitor types to see the resume.
RESUME_PASSWORD=

# Signs the access cookie and decrypts private/resume.pdf.enc. Generate with
#   openssl rand -hex 32
# Changing it means re-running `npm run resume:encrypt`.
RESUME_SECRET=
